@page

@{
    ViewData["Title"] = "Şifre Değiştirildi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Satır Arası</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
</head>

<body>
    <div class="identity-container">
        <div class="identity-card text-center">
            <h1 class="identity-title">Şifre Değiştirildi</h1>
            <p class="identity-subtitle">Şifreniz başarıyla değiştirildi. Yeni şifrenizle giriş yapabilirsiniz.</p>
            <a asp-page="./Login" class="btn identity-btn identity-btn-primary">Giriş Yap</a>
        </div>
    </div>
</body>
</html>
