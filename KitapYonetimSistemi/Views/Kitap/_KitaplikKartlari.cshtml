@model IEnumerable<KitapYonetimSistemi.Models.KullaniciKitaplik>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var kayit in Model)
        {
            <div class="col-md-4">
                <div class="card">
                    <partial name="_Kapak" model='KapakModel.Of(kayit.Kitap, "md")' />

                    <div class="card-body">
                        <h5 class="card-title">@kayit.Kitap.KitapAdi</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@kayit.Kitap.YazarAdi</h6>

                        <!-- Durum Badge -->
                        <div class="mb-2">
                            @switch (kayit.OkumaDurumu)
                            {
                                case OkumaDurumu.Okunacak:
                                    <span class="badge status-okunacak">📖 Okunacak</span>
                                    break;
                                case OkumaDurumu.Okuyorum:
                                    <span class="badge status-okuyorum">📕 Okuyorum</span>
                                    break;
                                case OkumaDurumu.Okundu:
                                    <span class="badge status-okundu">✅ Okundu</span>
                                    break;
                            }
                        </div>

                        @if (kayit.OkumaDurumu == OkumaDurumu.Okuyorum)
                        {
                            var toplam = kayit.Kitap.SayfaSayisi;
                            var mevcut = kayit.MevcutSayfa ?? 0;
                            var yuzde = toplam > 0 ? Math.Min(100, mevcut * 100 / toplam.Value) : 0;

                            @if (toplam.HasValue)
                            {
                                <div class="progress mb-1" style="height: 14px;">
                                    <div class="progress-bar bg-success" style="width: @yuzde%;">%@yuzde</div>
                                </div>
                                <div class="small text-muted mb-2">@mevcut / @toplam sayfa</div>
                            }
                            else if (kayit.MevcutSayfa.HasValue)
                            {
                                <div class="small text-muted mb-2">@mevcut. sayfadasınız</div>
                            }

                            <form asp-action="IlerlemeGuncelle" method="post" class="mb-2">
                                <input type="hidden" name="kitaplikId" value="@kayit.Id" />
                                <div class="input-group input-group-sm mb-1">
                                    <input type="number" name="sayfa" class="form-control" min="0" max="@(toplam ?? 20000)" value="@mevcut" placeholder="Sayfa" required />
                                    <button type="submit" class="btn btn-outline-success">Kaydet</button>
                                </div>
                                <input type="text" name="not" class="form-control form-control-sm" maxlength="500" placeholder="Not (isteğe bağlı)" />
                            </form>
                        }

                        <!-- Durum Değiştir -->
                        <form asp-action="OkumaDurumuDegistir" method="post">
                            <input type="hidden" name="kitaplikId" value="@kayit.Id" />
                            <select name="yeniDurum" class="form-select form-select-sm mb-2" onchange="this.form.submit()">
                                <option value="">-- Durum Değiştir --</option>
                                <option value="1" selected="@(kayit.OkumaDurumu == OkumaDurumu.Okunacak)">📖 Okunacak</option>
                                <option value="2" selected="@(kayit.OkumaDurumu == OkumaDurumu.Okuyorum)">📕 Okuyorum</option>
                                <option value="3" selected="@(kayit.OkumaDurumu == OkumaDurumu.Okundu)">✅ Okundu</option>
                            </select>
                        </form>

                        <div class="small text-muted">
                            <div>Eklenme: @kayit.EklenmeTarihi.ToString("dd.MM.yyyy")</div>
                            @if (kayit.OkumayaBaslamaTarihi.HasValue)
                            {
                                <div>Başlama: @kayit.OkumayaBaslamaTarihi.Value.ToString("dd.MM.yyyy")</div>
                            }
                            @if (kayit.OkumaBitisTarihi.HasValue)
                            {
                                <div>Bitiş: @kayit.OkumaBitisTarihi.Value.ToString("dd.MM.yyyy")</div>
                            }
                        </div>
                    </div>

                    <div class="card-footer bg-white">
                        <a asp-action="Detay" asp-route-id="@kayit.KitapId" class="btn btn-sm btn-primary">Detay</a>
                        <form asp-action="KitapliktanCikar" method="post" class="d-inline" onsubmit="return confirm('Emin misiniz?');">
                            <input type="hidden" name="kitapId" value="@kayit.KitapId" />
                            <button type="submit" class="btn btn-sm btn-danger">Çıkar</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted text-center">Bu kategoride kitap bulunmuyor.</p>
}