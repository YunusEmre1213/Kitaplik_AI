@model KitapYonetimSistemi.Models.KitapListeViewModel

@{
    ViewData["Title"] = "Kitaplar";
}

<div class="katalog-ust">
    <h1 class="page-title">Kitaplar</h1>
    <span class="katalog-sayac">@Model.ToplamKayit.ToString("N0") kitap</span>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Mesaj"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" asp-action="Index" class="filtre-cubugu row g-2 align-items-center">
    <div class="col-lg-4">
        <input type="text" name="arama" value="@Model.Arama" class="form-control" placeholder="Kitap adı veya yazar ara..." />
    </div>
    <div class="col-6 col-lg-2">
        <select name="tur" class="form-select">
            <option value="">Tüm türler</option>
            @foreach (var t in KitapYonetimSistemi.Models.KitapTurleri.Hepsi)
            {
                <option value="@t" selected="@(Model.Tur == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-6 col-lg-2">
        <select name="siralama" class="form-select">
            <option value="yeni" selected="@(Model.Siralama == "yeni")">En yeni</option>
            <option value="puan" selected="@(Model.Siralama == "puan")">En yüksek puan</option>
            <option value="ad" selected="@(Model.Siralama == "ad")">Kitap adı (A-Z)</option>
            <option value="yazar" selected="@(Model.Siralama == "yazar")">Yazar (A-Z)</option>
        </select>
    </div>
    <div class="col-6 col-lg-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="kapakli" value="true" id="kapakliFiltre" checked="@Model.Kapakli" />
            <label class="form-check-label" for="kapakliFiltre">Yalnızca kapaklı</label>
        </div>
    </div>
    <div class="col-6 col-lg-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Ara</button>
        <a asp-action="Index" class="btn btn-outline-secondary" title="Temizle">✕</a>
    </div>
</form>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Hata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.DisSonuclar.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <strong>🌐 Kataloğumuzda olmayan sonuçlar</strong>
            <small class="text-muted d-block">Dış kaynaklarda bulundu. Ekleyince kataloğa ve kitaplığınıza girer.</small>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var dis in Model.DisSonuclar)
            {
                <li class="list-group-item dis-sonuc">
                    <div style="width: 48px; flex: none;"><partial name="_Kapak" model='new KapakModel(dis.KapakUrl, dis.Baslik, null, "sm")' /></div>
                    <div class="flex-grow-1">
                        <div class="fw-bold">@dis.Baslik</div>
                        <div class="small text-muted">
                            @dis.Yazar
                            @if (dis.Yil > 0) { <span>· @dis.Yil</span> }
                            @if (dis.SayfaSayisi.HasValue) { <span>· @dis.SayfaSayisi sayfa</span> }
                        </div>
                    </div>
                    <form asp-action="DisKaynaktanKitapligaEkle" method="post">
                        <input type="hidden" name="disKaynakId" value="@dis.DisKaynakId" />
                        <button type="submit" class="btn btn-sm btn-success">Kitaplığıma Ekle</button>
                    </form>
                </li>
            }
        </ul>
        <div class="card-footer bg-white small text-muted">Kaynak: @string.Join(", ", Model.DisSonuclar.Select(d => d.Kaynak).Distinct())</div>
    </div>
}



@if (Model.Kitaplar.Any())
{
    <div class="kitap-izgara">
        @foreach (var kitap in Model.Kitaplar)
        {
            <div class="kitap-kart">
                <a asp-action="Detay" asp-route-id="@kitap.Id" class="kitap-baglanti" title="@kitap.KitapAdi">
                    <partial name="_Kapak" model='KapakModel.Of(kitap, "md")' />
                    <div class="kitap-ad">@kitap.KitapAdi</div>
                </a>
                <div class="kitap-yazar">@(string.IsNullOrWhiteSpace(kitap.YazarAdi) ? "Yazar bilinmiyor" : kitap.YazarAdi)</div>
                <div class="kitap-meta">
                    @if (!string.IsNullOrEmpty(kitap.Tur)) { <span class="kitap-etiket">@kitap.Tur</span> }
                    @if (kitap.YayinYili > 0) { <span>@kitap.YayinYili</span> }
                    @if (kitap.ToplamPuanSayisi > 0) { <span class="kitap-puan">★ @kitap.OrtalamaPuan.ToString("0.0")</span> }
                </div>
                <div class="kitap-eylemler">
                    <a asp-controller="AiLibrary" asp-action="AnalizEt" asp-route-id="@kitap.Id"
                       class="btn btn-sm btn-outline-primary" title="Yapay Zeka Analizi"
                       onclick="document.getElementById('aiLoadingOverlay').style.display = 'flex';">AI</a>
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#kitapligaEkleModal"
                            data-kitap-id="@kitap.Id" data-kitap-adi="@kitap.KitapAdi">Ekle</button>
                </div>
            </div>
        }
    </div>

    <div class="modal fade" id="kitapligaEkleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Kitaplığa Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="KitapligaEkleYeni" method="post">
                    <div class="modal-body">
                        <p class="fw-bold" id="ekleKitapAdi"></p>
                        <input type="hidden" name="kitapId" id="ekleKitapId" />
                        <div class="mb-3">
                            <label class="form-label">Okuma Durumu:</label>
                            <select name="okumaDurumu" class="form-select">
                                <option value="1">📖 Okunacak</option>
                                <option value="2">📕 Okuyorum</option>
                                <option value="3">✅ Okundu</option>
                            </select>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="herkesGorebilir" id="ekleHerkes">
                            <label class="form-check-label" for="ekleHerkes">Herkes görebilsin</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary">Ekle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.ToplamSayfa > 1)
    {
        // Binlerce sayfa olabileceği için yalnızca geçerli sayfanın çevresi gösterilir
        var bas = Math.Max(1, Model.Sayfa - 2);
        var son = Math.Min(Model.ToplamSayfa, Model.Sayfa + 2);
        <nav class="mt-5" aria-label="Sayfalama">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(Model.Sayfa == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-sayfa="@(Model.Sayfa - 1)" asp-route-arama="@Model.Arama" asp-route-tur="@Model.Tur" asp-route-siralama="@Model.Siralama" asp-route-kapakli="@Model.Kapakli">Önceki</a>
                </li>
                @if (bas > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-sayfa="1" asp-route-arama="@Model.Arama" asp-route-tur="@Model.Tur" asp-route-siralama="@Model.Siralama" asp-route-kapakli="@Model.Kapakli">1</a></li>
                    @if (bas > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                }
                @for (var i = bas; i <= son; i++)
                {
                    <li class="page-item @(i == Model.Sayfa ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-sayfa="@i" asp-route-arama="@Model.Arama" asp-route-tur="@Model.Tur" asp-route-siralama="@Model.Siralama" asp-route-kapakli="@Model.Kapakli">@i</a>
                    </li>
                }
                @if (son < Model.ToplamSayfa)
                {
                    @if (son < Model.ToplamSayfa - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-sayfa="@Model.ToplamSayfa" asp-route-arama="@Model.Arama" asp-route-tur="@Model.Tur" asp-route-siralama="@Model.Siralama" asp-route-kapakli="@Model.Kapakli">@Model.ToplamSayfa</a></li>
                }
                <li class="page-item @(Model.Sayfa == Model.ToplamSayfa ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-sayfa="@(Model.Sayfa + 1)" asp-route-arama="@Model.Arama" asp-route-tur="@Model.Tur" asp-route-siralama="@Model.Siralama" asp-route-kapakli="@Model.Kapakli">Sonraki</a>
                </li>
            </ul>
        </nav>
    }
}
else if (!string.IsNullOrWhiteSpace(Model.Arama) || !string.IsNullOrWhiteSpace(Model.Tur) || Model.Kapakli)
{
    <div class="alert alert-warning text-center py-5">
        <h4>🔍 Sonuç bulunamadı</h4>
        <p>Aramanızı değiştirmeyi veya filtreleri temizlemeyi deneyin.</p>
    </div>
}
else
{
    <div class="alert alert-info text-center py-5">
        <h4>📚 Henüz Kitap Yok</h4>
        <p>Admin henüz kitap eklememiş.</p>
    </div>
}

<div id="aiLoadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 9999; align-items: center; justify-content: center; flex-direction: column; backdrop-filter: blur(5px);">
    <div class="spinner-border text-light" style="width: 3rem; height: 3rem;" role="status"></div>
    <h3 class="mt-3 text-white fw-bold">Yapay Zeka Düşünüyor...</h3>
    <p class="text-white-50">Kitabı inceliyor, lütfen bekleyin.</p>
</div>

@section Scripts {
    <script>
        document.getElementById('kitapligaEkleModal')?.addEventListener('show.bs.modal', function (e) {
            var d = e.relatedTarget.dataset;
            document.getElementById('ekleKitapId').value = d.kitapId;
            document.getElementById('ekleKitapAdi').textContent = d.kitapAdi;
        });
    </script>
}
