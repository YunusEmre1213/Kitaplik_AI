@using System.Security.Claims
@model KitapYonetimSistemi.Models.Kitap

@{
    ViewData["Title"] = Model.KitapAdi;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Kitaplar</a></li>
        <li class="breadcrumb-item active">@Model.KitapAdi</li>
    </ol>
</nav>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Mesaj"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Kitap Bilgileri -->
<div class="card mb-4">
    <div class="row g-0">
        <div class="col-md-4">
            <div class="p-4"><partial name="_Kapak" model='KapakModel.Of(Model, "lg")' /></div>
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h1 class="card-title text-primary">@Model.KitapAdi</h1>
                <h5 class="card-subtitle mb-3 text-muted">Yazar: @Model.YazarAdi</h5>
                <p><strong>Yayın Yılı:</strong> @Model.YayinYili</p>
                @if (Model.SayfaSayisi.HasValue)
                {
                    <p><strong>Sayfa Sayısı:</strong> @Model.SayfaSayisi</p>
                }
                @if (!string.IsNullOrEmpty(Model.Tur))
                {
                    <p><strong>Tür:</strong> @Model.Tur</p>
                }
                <p><strong>Eklenme Tarihi:</strong> @Model.EklenmeTarihi.ToString("dd MMMM yyyy")</p>
                <hr />
                <h5>Açıklama:</h5>
                @if (string.IsNullOrWhiteSpace(Model.Aciklama))
                {
                    <p class="text-muted fst-italic">Bu kitap için henüz bir açıklama eklenmemiş.</p>
                }
                else
                {
                    <p class="lead">@Model.Aciklama</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Puan Sistemi -->
<div class="card mb-4">
    <div class="card-header bg-warning text-white">⭐ Kitap Puanı</div>
    <div class="card-body text-center">
        @if (Model.ToplamPuanSayisi > 0)
        {
            <h2 class="display-4 text-warning">@Model.OrtalamaPuan.ToString("0.0")</h2>
            <div style="font-size: 2rem; color: #ffc107;">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(Model.OrtalamaPuan))
                    {
                        <span>⭐</span>
                    }
                    else
                    {
                        <span style="color: var(--sa-line);">☆</span>
                    }
                }
            </div>
            <p class="text-muted">@Model.ToplamPuanSayisi kişi puanladı</p>
        }
        else
        {
            <h4 class="text-muted">Henüz puanlanmadı</h4>
            <p>İlk puanı siz verin!</p>
        }

        <hr />

        <h5 class="mb-3">
            @if (ViewBag.KullaniciPuani != null)
            {
                <span>Sizin Puanınız: @ViewBag.KullaniciPuani ⭐</span>
            }
            else
            {
                <span>Bu kitaba puan verin:</span>
            }
        </h5>

        <form asp-action="PuanVer" method="post" id="ratingForm" class="d-inline">
            <input type="hidden" name="kitapId" value="@Model.Id" />
            <input type="hidden" name="puan" id="puanInput" value="@(ViewBag.KullaniciPuani ?? 0)" />

            <div style="font-size: 2.5rem;">
                @for (int i = 1; i <= 5; i++)
                {
                    <button type="button" class="btn btn-link p-0 text-decoration-none @(ViewBag.KullaniciPuani >= i ? "text-warning" : "text-secondary")"
                            style="font-size: 2.5rem;" onclick="setPuan(@i)">
                        ⭐
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- Alıntılar -->
@{
    var mevcutKullaniciId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var alintilar = (Model.Alintilar ?? new List<KitapYonetimSistemi.Models.Alinti>())
        .OrderByDescending(a => a.Begeniler.Count)
        .ThenByDescending(a => a.Tarih)
        .ToList();
}
<div class="card mb-4">
    <div class="card-header">❝ Alıntılar (@alintilar.Count)</div>
    <div class="card-body">
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger">@TempData["Hata"]</div>
        }

        @if (alintilar.Any())
        {
            @foreach (var alinti in alintilar)
            {
                var begendi = alinti.Begeniler.Any(b => b.KullaniciId == mevcutKullaniciId);
                <figure class="border-start border-4 border-warning ps-3 mb-4">
                    <blockquote class="blockquote mb-1" style="white-space: pre-line;">@alinti.Metin</blockquote>
                    <figcaption class="small text-muted">
                        👤 @alinti.Kullanici?.UserName
                        @if (alinti.SayfaNo.HasValue)
                        {
                            <span> · s. @alinti.SayfaNo</span>
                        }
                        · @alinti.Tarih.ToString("dd.MM.yyyy")
                    </figcaption>
                    <div class="d-flex gap-2 mt-2">
                        <form asp-action="AlintiBegen" method="post">
                            <input type="hidden" name="alintiId" value="@alinti.Id" />
                            <button type="submit" class="btn btn-sm @(begendi ? "btn-danger" : "btn-outline-danger")">
                                ❤ @alinti.Begeniler.Count
                            </button>
                        </form>
                        @if (alinti.KullaniciId == mevcutKullaniciId)
                        {
                            <form asp-action="AlintiSil" method="post" onsubmit="return confirm('Alıntı silinsin mi?');">
                                <input type="hidden" name="alintiId" value="@alinti.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Sil</button>
                            </form>
                        }
                    </div>
                </figure>
            }
        }
        else
        {
            <p class="text-muted text-center">Henüz alıntı paylaşılmamış. İlk alıntıyı siz ekleyin!</p>
        }

        <hr />

        <h5>Alıntı Ekle</h5>
        <form asp-action="AlintiEkle" method="post">
            <input type="hidden" name="kitapId" value="@Model.Id" />
            <div class="mb-2">
                <textarea name="metin" class="form-control" rows="3" maxlength="1000" placeholder="Kitaptan etkilendiğiniz bir bölüm..." required></textarea>
            </div>
            <div class="row g-2">
                <div class="col-md-3">
                    <input type="number" name="sayfaNo" class="form-control" min="1" max="20000" placeholder="Sayfa no (isteğe bağlı)" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-warning">Alıntıyı Paylaş</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Yorumlar -->
<div class="card mb-4">
    <div class="card-header">💬 Yorumlar (@(Model.Yorumlar?.Count ?? 0))</div>
    <div class="card-body">
        @if (Model.Yorumlar != null && Model.Yorumlar.Any())
        {
            @foreach (var yorum in Model.Yorumlar.OrderByDescending(y => y.YorumTarihi))
            {
                <div class="border-start border-4 border-primary ps-3 mb-3">
                    <h6 class="text-muted mb-2">
                        👤 @yorum.Kullanici.UserName
                        <small>- @yorum.YorumTarihi.ToString("dd.MM.yyyy HH:mm")</small>
                    </h6>
                    @if (yorum.Spoiler)
                    {
                        <details>
                            <summary class="text-warning">⚠️ Bu yorum spoiler içeriyor, görmek için tıklayın</summary>
                            <p class="mb-0 mt-2">@yorum.YorumMetni</p>
                        </details>
                    }
                    else
                    {
                        <p class="mb-0">@yorum.YorumMetni</p>
                    }
                </div>
            }
        }
        else
        {
            <p class="text-muted text-center">Henüz yorum yapılmamış. İlk yorumu siz yapın!</p>
        }

        <hr />

        <h5>Yorum Yap</h5>
        <form asp-action="YorumEkle" method="post">
            <input type="hidden" name="kitapId" value="@Model.Id" />
            <div class="mb-3">
                <textarea name="yorumMetni" class="form-control" rows="3" placeholder="Yorumunuzu yazın..." required></textarea>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="spoiler" value="true" id="spoilerCheck" />
                <label class="form-check-label" for="spoilerCheck">Bu yorum spoiler içeriyor</label>
            </div>
            <button type="submit" class="btn btn-primary">Yorum Gönder</button>
            <a asp-action="Index" class="btn btn-secondary">Kitaplara Dön</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function setPuan(rating) {
            document.getElementById('puanInput').value = rating;
            document.getElementById('ratingForm').submit();
        }
    </script>
}