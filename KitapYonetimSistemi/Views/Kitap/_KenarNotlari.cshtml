@model KitapYonetimSistemi.Models.KenarNotlariViewModel

@{
    var giris = !string.IsNullOrEmpty(Model.KullaniciId);
    string Ad(string? kullaniciAdi) => string.IsNullOrEmpty(kullaniciAdi) ? "okur" : kullaniciAdi.Split('@')[0];
    var maks = Model.KitapSayfaSayisi ?? 20000;
}

<section class="kenar-bolum" id="kenar-notlari">
    <div class="bolum-baslik">
        <h2>Kenar notları</h2>
        <span class="etiket">@Model.Isi.ToplamIsaret işaret</span>
    </div>

    @* Isı şeridi: okurların herkese açık alıntı ve notlarıyla işaretlediği sayfalar *@
    @if (Model.Isi.ToplamIsaret > 0)
    {
        <div class="isi-serit" role="img" aria-label="Okurların işaretlediği sayfaların yoğunluğu">
            @foreach (var d in Model.Isi.Dilimler)
            {
                <span class="isi-hucre seviye-@d.Seviye" title="@(d.Bas == d.Son ? $"s. {d.Bas}" : $"s. {d.Bas}-{d.Son}")@(d.Sayi > 0 ? $": {d.Sayi} işaret" : "")"></span>
            }
        </div>
        <div class="isi-alt">
            <span>1</span>
            <span class="isi-enler">
                En çok işaretlenen:
                @string.Join(", ", Model.Isi.EnCokIsaretlenen.Select(e => $"s. {e.Sayfa} ({e.Sayi})"))
            </span>
            <span>@Model.Isi.ToplamSayfa</span>
        </div>
    }
    else
    {
        <p class="text-muted">Henüz kimse bu kitabın sayfalarını işaretlememiş. İlk notu sen bırak; herkese açık notlar ve sayfa numaralı alıntılar burada ısı haritasına dönüşür.</p>
    }

    @* Tepki haritası: duygusal eğri. Okurun ulaştığı sayfanın ötesi spoiler olmaması için kilitli. *@
    @{
        (string Emoji, string Ad) TepkiBilgi(TepkiTuru t) => t switch
        {
            TepkiTuru.Saskin => ("😮", "Şaşırdım"),
            TepkiTuru.Aglatti => ("😢", "Ağlattı"),
            TepkiTuru.Guldurdu => ("😄", "Güldürdü"),
            _ => ("😴", "Sıkıcı")
        };
        var tepki = Model.Tepki;
    }
    <div class="tepki-bolum" id="tepki-haritasi">
        <h3 class="tepki-baslik">Duygu eğrisi <span class="etiket">@tepki.ToplamTepki tepki</span></h3>
        @if (tepki.Dilimler.Count > 0)
        {
            <div class="isi-serit tepki-serit" role="img" aria-label="Okurların sayfalara bıraktığı duygu tepkileri">
                @foreach (var d in tepki.Dilimler)
                {
                    var sayfaMetni = d.Bas == d.Son ? $"s. {d.Bas}" : $"s. {d.Bas}-{d.Son}";
                    if (d.Kilitli)
                    {
                        <span class="isi-hucre tepki-kilitli" title="@sayfaMetni: okuyunca açılır"></span>
                    }
                    else
                    {
                        <span class="isi-hucre @(d.Baskin.HasValue ? "tepki-" + d.Baskin.Value.ToString().ToLowerInvariant() : "")"
                              title="@sayfaMetni@(d.Baskin.HasValue ? ": " + string.Join(", ", d.Sayilar.OrderByDescending(x => x.Value).Select(x => $"{TepkiBilgi(x.Key).Ad} {x.Value}")) : "")"></span>
                    }
                }
            </div>
            <div class="tepki-ipucu">
                @if (Model.Bitirdi)
                {
                    <span>Kitabı bitirdin, tüm eğri açık.</span>
                }
                else if (Model.OkuyucuSayfasi.HasValue)
                {
                    <span>Spoiler olmaması için yalnızca @Model.OkuyucuSayfasi. sayfaya kadar olan tepkiler görünür.</span>
                }
                else
                {
                    <span>Kitaplığında ilerlemeni girince, okuduğun kısma kadar olan tepkiler açılır.</span>
                }
            </div>
        }
        <div class="tepki-lejant">
            @foreach (var t in Enum.GetValues<TepkiTuru>())
            {
                <span><i class="tepki-nokta tepki-@t.ToString().ToLowerInvariant()"></i>@TepkiBilgi(t).Ad</span>
            }
        </div>
        @if (giris)
        {
            <form asp-action="TepkiVer" method="post" class="tepki-form">
                <input type="hidden" name="kitapId" value="@Model.KitapId" />
                <input type="number" name="sayfaNo" class="form-control" min="1" max="@(Model.Bitirdi ? maks : Math.Min(maks, Math.Max(1, Model.OkuyucuSayfasi ?? 1)))" value="@(Model.OkuyucuSayfasi)" placeholder="Sayfa" required aria-label="Tepki sayfası" />
                @foreach (var t in Enum.GetValues<TepkiTuru>())
                {
                    <button type="submit" name="tur" value="@((int)t)" class="btn btn-outline-secondary btn-sm" title="@TepkiBilgi(t).Ad">@TepkiBilgi(t).Emoji @TepkiBilgi(t).Ad</button>
                }
            </form>
            <div class="tepki-ipucu">Yalnızca okuduğun sayfalara tepki bırakabilirsin. Aynı tepkiye tekrar basarsan geri alınır.</div>
        }
    </div>

    @{ var b = Model.Birakma; }
    @if (b.Yeterli)
    {
        <div class="birakma-kutu">
            <h3 class="tepki-baslik">Okurlar nerede bırakıyor?</h3>
            <p>
                Bu kitaba başlayıp bir sonuca varan @b.Karar okurun %@b.BitirmeYuzdesi'i bitirdi, @b.Birakan kişi yarıda bıraktı.
                Bırakanların yarısı
                @if (b.MedyanYuzde.HasValue)
                {
                    <text><strong>@b.MedyanSayfa. sayfadan</strong> (kitabın %@b.MedyanYuzde'si) önce bıraktı.</text>
                }
                else
                {
                    <text><strong>@b.MedyanSayfa. sayfadan</strong> önce bıraktı.</text>
                }
                @if (b.AsanlarinBitirmeYuzdesi.HasValue)
                {
                    <text> Bu sayfayı geçenlerin %@b.AsanlarinBitirmeYuzdesi'i kitabı bitirdi.</text>
                }
            </p>
            <div class="tepki-ipucu">Son 30 gündür hiç okunmayan ve bitmemiş kitaplar "bırakılmış" sayılır. Yalnızca toplu sayılar gösterilir.</div>
        </div>
    }

    @if (Model.Notlar.Any())
    {
        <ul class="kenar-liste">
            @foreach (var n in Model.Notlar)
            {
                var benim = n.KullaniciId == Model.KullaniciId;
                var kilitli = Model.KilitliNotlar.Contains(n.Id);
                <li>
                    <span class="kenar-sayfa">s. @n.SayfaNo</span>
                    <div class="kenar-icerik @(kilitli ? "kapsul-kilitli" : "")">
                        @if (kilitli)
                        {
                            <p class="kapsul-metin">🔒 Zaman kapsülü: @(n.KapsulBitinceAc && n.KapsulAcilisTarihi.HasValue ? $"kitabı bitirince ya da {n.KapsulAcilisTarihi:dd.MM.yyyy} tarihinde açılır" : n.KapsulBitinceAc ? "kitabı bitirince açılır" : $"{n.KapsulAcilisTarihi:dd.MM.yyyy} tarihinde açılır")</p>
                        }
                        else
                        {
                            <p>@n.Metin</p>
                        }
                        <div class="kenar-alt">
                            @if (benim)
                            {
                                <span>@(n.KapsulBitinceAc || n.KapsulAcilisTarihi.HasValue ? "Kapsül" : n.HerkeseAcik ? "Herkese açık" : "Yalnızca sen")</span>
                            }
                            else
                            {
                                <span>@Ad(n.Kullanici?.UserName)</span>
                            }
                            <span>@n.Tarih.ToString("dd.MM.yyyy")</span>
                            @if (benim)
                            {
                                <form asp-action="KenarNotuSil" method="post" onsubmit="return confirm('Not silinsin mi?');" class="d-inline">
                                    <input type="hidden" name="notId" value="@n.Id" />
                                    <button type="submit" class="cikar-btn">Sil</button>
                                </form>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
    }

    @if (giris)
    {
        <form asp-action="KenarNotuEkle" method="post" class="kenar-form">
            <input type="hidden" name="kitapId" value="@Model.KitapId" />
            <div class="row g-2">
                <div class="col-4 col-md-2">
                    <input type="number" name="sayfaNo" class="form-control" min="1" max="@maks" placeholder="Sayfa" required aria-label="Sayfa numarası" />
                </div>
                <div class="col-8 col-md-10">
                    <input type="text" name="metin" class="form-control" maxlength="1000" placeholder="Bu sayfa için bir not bırak..." required aria-label="Not" />
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="herkeseAcik" value="true" id="notHerkeseAcik" />
                        <label class="form-check-label" for="notHerkeseAcik">Herkese açık olsun (ısı haritasına eklenir)</label>
                    </div>
                    <select name="kapsul" class="form-select form-select-sm w-auto" aria-label="Zaman kapsülü" title="Zaman kapsülü: notu bugünden gizleyip geleceğe bırak">
                        <option value="yok">Hemen göster</option>
                        <option value="bitince">🔒 Kitabı bitirince aç</option>
                        <option value="6ay">🔒 6 ay sonra aç</option>
                        <option value="1yil">🔒 1 yıl sonra aç</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Notu ekle</button>
            </div>
        </form>
    }
</section>
