@model IEnumerable<KitapYonetimSistemi.Models.KullaniciKitaplik>

@{
    ViewData["Title"] = "Kitaplığım";
}

<div class="sayfa-baslik">
    <div>
        <span class="etiket">Kişisel</span>
        <h1>Kitaplığım</h1>
        <span class="not">@Model.Count() kitap</span>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "AiLibrary")" id="aiOneriBtn" class="btn btn-primary d-flex align-items-center gap-2">
            <span id="btnText">Yapay zekâdan öneri al</span>
            <span id="loadingSpinner" class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="display:none;"></span>
        </a>
        <a asp-action="OkumaIstatistiklerim" class="btn btn-outline-secondary">İstatistikler</a>
    </div>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mesaj"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Hata"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewBag.AktifOturum is OkumaOturumu aktif)
{
    var kitapAdi = aktif.KullaniciKitaplik?.Kitap?.KitapAdi;
    var toplamSayfa = aktif.KullaniciKitaplik?.Kitap?.SayfaSayisi;
    <section class="oturum-panel" id="oturum">
        <div>
            <span class="etiket">Okuma oturumu</span>
            <div class="oturum-baslik">@kitapAdi</div>
            <div class="oturum-buyuk" data-oturum-baslangic="@(new DateTimeOffset(DateTime.SpecifyKind(aktif.Baslangic, DateTimeKind.Local)).ToUnixTimeMilliseconds())">00:00</div>
            <div class="text-muted small">@aktif.Baslangic.ToString("HH:mm") başlangıcından beri @(aktif.BaslangicSayfa.HasValue ? $"· {aktif.BaslangicSayfa}. sayfadan başladın" : "")</div>
        </div>
        <form asp-action="OturumBitir" method="post" class="oturum-form">
            <input type="hidden" name="oturumId" value="@aktif.Id" />
            <label class="form-label" for="oturumSayfa">Şu an kaçıncı sayfadasın?</label>
            <div class="input-group">
                <input type="number" id="oturumSayfa" name="sayfa" class="form-control" min="@(aktif.BaslangicSayfa ?? 0)" max="@(toplamSayfa ?? 20000)" value="@(aktif.BaslangicSayfa ?? 0)" required />
                <button type="submit" class="btn btn-primary">Oturumu bitir</button>
            </div>
        </form>
        <form asp-action="OturumIptal" method="post" onsubmit="return confirm('Oturum kaydedilmeden iptal edilsin mi?');" class="oturum-iptal">
            <input type="hidden" name="oturumId" value="@aktif.Id" />
            <button type="submit" class="cikar-btn">İptal et</button>
        </form>
    </section>
}

@if (Model.Any())
{
    <div class="mb-4">
        <div class="mb-4">
            <ul class="nav kitaplik-sekme" id="myTab" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#all" type="button">
                        Tümü <span class="sayac">@Model.Count()</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#toread" type="button">
                        Okunacak <span class="sayac">@Model.Count(k => k.OkumaDurumu == OkumaDurumu.Okunacak)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#reading" type="button">
                        Okuyorum <span class="sayac">@Model.Count(k => k.OkumaDurumu == OkumaDurumu.Okuyorum)</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#read" type="button">
                        Okundu <span class="sayac">@Model.Count(k => k.OkumaDurumu == OkumaDurumu.Okundu)</span>
                    </button>
                </li>
            </ul>
        </div>

        <div>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="all">
                    @await Html.PartialAsync("_KitaplikKartlari", Model)
                </div>
                <div class="tab-pane fade" id="toread">
                    @await Html.PartialAsync("_KitaplikKartlari", Model.Where(k => k.OkumaDurumu == OkumaDurumu.Okunacak))
                </div>
                <div class="tab-pane fade" id="reading">
                    @await Html.PartialAsync("_KitaplikKartlari", Model.Where(k => k.OkumaDurumu == OkumaDurumu.Okuyorum))
                </div>
                <div class="tab-pane fade" id="read">
                    @await Html.PartialAsync("_KitaplikKartlari", Model.Where(k => k.OkumaDurumu == OkumaDurumu.Okundu))
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="mb-3">
            <i class="bi bi-journal-bookmark display-1 text-muted"></i>
        </div>
        <h4 class="text-muted">Kitaplığınız Henüz Boş</h4>
        <p class="text-secondary mb-4">Okuduğunuz veya okumak istediğiniz kitapları ekleyerek başlayın.</p>
        <a asp-action="Index" asp-controller="Home" class="btn btn-primary btn-lg">
            <i class="bi bi-search"></i> Kitaplara Göz At
        </a>
    </div>
}
@section Scripts {
    <script>
        document.getElementById('aiOneriBtn').addEventListener('click', function(e) {
            var btn = this;
            var now = new Date().getTime();
            var lastClick = localStorage.getItem('lastAiRequestTime');

            // 1. ZAMAN KONTROLÜ (10 Saniye Kuralı)
            // Eğer son tıklama üzerinden 10 saniye (10000 ms) geçmediyse engelle
            if (lastClick && (now - lastClick < 10000)) {
                e.preventDefault(); // Sayfaya gitmeyi durdur

                var kalanSure = Math.ceil((10000 - (now - lastClick)) / 1000);
                alert('Çok hızlı işlem yapıyorsunuz! Lütfen ' + kalanSure + ' saniye bekleyin.');
                return;
            }

            // 2. BUTONU KİLİTLEME (Görsel Geri Bildirim)
            // Eğer süre dolmuşsa veya ilk kez tıklanıyorsa:

            // Tıklamayı kaydet
            localStorage.setItem('lastAiRequestTime', now);

            // Butonu pasif görünüme sok (Pointer events ile tıklamayı engelle)
            btn.style.pointerEvents = 'none';
            btn.style.opacity = '0.7';

            // Yazıyı ve ikonu değiştir
            document.getElementById('btnText').innerText = 'AI Hazırlanıyor...';
            document.querySelector('.bi-stars').style.display = 'none';
            document.getElementById('loadingSpinner').style.display = 'inline-block';

            // Sayfanın yönlenmesine izin ver (href çalışacak)
        });
    </script>
}

