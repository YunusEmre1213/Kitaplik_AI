@model IEnumerable<KitapYonetimSistemi.Models.OkumaSezonu>

@{
    ViewData["Title"] = "Okuma sezonları";
    var simdi = DateTime.Now;
    var kullaniciId = ViewBag.KullaniciId as string;
    var liste = Model.Select(s => (Sezon: s, Takvim: new SezonTakvimi(s.Baslangic, s.GunSayisi, s.Kitap?.SayfaSayisi ?? 1))).ToList();
    var gruplar = new (string Baslik, SezonDurumu Durum)[]
    {
        ("Şu an okunan", SezonDurumu.Surmekte),
        ("Yakında başlayacak", SezonDurumu.Yaklasan),
        ("Biten sezonlar", SezonDurumu.Bitti)
    };
}

<div class="sayfa-baslik">
    <div>
        <span class="etiket">Birlikte oku</span>
        <h1>Okuma sezonları</h1>
        <span class="not">Bir kitabı topluluk günlük bölümlerle birlikte okur. Bölümü okuyunca sohbeti açılır; kimse spoiler yemez.</span>
    </div>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Mesaj"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Hata"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (!liste.Any())
{
    <p class="text-muted">Henüz sezon yok. Bir kitabın sayfasındaki "Sezon başlat" bölümünden ilk sezonu sen aç.</p>
}

@foreach (var (baslik, durum) in gruplar)
{
    var grup = liste.Where(x => x.Takvim.Durum(simdi) == durum).ToList();
    if (!grup.Any()) { continue; }
    <h2 class="sezon-grup">@baslik</h2>
    <ul class="oda-liste">
        @foreach (var (s, t) in grup)
        {
            <li>
                <a asp-action="Detay" asp-route-id="@s.Id" class="oda-kart">
                    <span class="oda-ad">@s.Ad</span>
                    <span class="oda-alt">
                        @s.Kitap?.KitapAdi · @t.BolumSayisi bölüm · @s.Uyeler.Count okur ·
                        @if (durum == SezonDurumu.Yaklasan) { <text>@s.Baslangic.ToString("dd.MM.yyyy") tarihinde başlıyor</text> }
                        else if (durum == SezonDurumu.Surmekte) { <text>bugün @t.BugunBolum. bölüm</text> }
                        else { <text>@t.BolumGunu(t.BolumSayisi).ToString("dd.MM.yyyy") tarihinde bitti</text> }
                        @if (s.Uyeler.Any(u => u.KullaniciId == kullaniciId)) { <text> · katıldın</text> }
                    </span>
                </a>
            </li>
        }
    </ul>
}
