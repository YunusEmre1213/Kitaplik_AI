@{
    ViewData["Title"] = "Ana Sayfa";
    var girisli = User.Identity?.IsAuthenticated == true;
    var okur = User.IsInRole("User");
}

<section class="ana-hero">
    <h1>Okuduklarını düzenle,<br /><span>yenilerini keşfet.</span></h1>
    <p>Kitaplığını kur, okuma hedeflerini takip et, düşüncelerini paylaş ve ruh haline göre kitap önerileri al.</p>
    @if (!girisli)
    {
        <div class="d-flex justify-content-center gap-2">
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary px-4">Ücretsiz Başla</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary px-4">Giriş Yap</a>
        </div>
    }
    else if (okur)
    {
        <a asp-controller="Kitap" asp-action="Index" class="btn btn-primary px-4">Kitaplara Göz At</a>
    }
    else if (User.IsInRole("Admin"))
    {
        <a asp-controller="Admin" asp-action="Index" class="btn btn-primary px-4">Yönetim Paneline Git</a>
    }
</section>

<section class="ana-ozellikler">
    <a class="ana-ozellik" asp-controller="Kitap" asp-action="Index">
        <div class="ikon"><i class="bi bi-journal-album"></i></div>
        <h5>Kataloğu keşfet</h5>
        <p>Binlerce kitap arasında yazar, tür ve puana göre ara.</p>
    </a>
    <a class="ana-ozellik" asp-controller="Kitap" asp-action="Kitapligim">
        <div class="ikon"><i class="bi bi-bookmarks"></i></div>
        <h5>Kitaplığını kur</h5>
        <p>Okunacak, okuyorum ve okundu listeleriyle ilerlemeni izle.</p>
    </a>
    <a class="ana-ozellik" asp-controller="AiLibrary" asp-action="RuhHali">
        <div class="ikon"><i class="bi bi-stars"></i></div>
        <h5>Ruh haline göre öneri</h5>
        <p>Yapay zekâ, o anki modunla eşleşen kitapları önerir.</p>
    </a>
    <a class="ana-ozellik" asp-controller="Tartisma" asp-action="Index">
        <div class="ikon"><i class="bi bi-chat-square-text"></i></div>
        <h5>Tartışmalara katıl</h5>
        <p>Diğer okurlarla kitaplar üzerine konuş, yorum yaz.</p>
    </a>
</section>
