<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <script>try{if(localStorage.getItem("sa-tema")==="dark"){var h=document.documentElement;h.setAttribute("data-theme","dark");h.setAttribute("data-bs-theme","dark");}}catch(e){}</script>
    <title>@ViewData["Title"] - Satır Arası</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:ital@1&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body>
    @{
        var kontrolcu = ViewContext.RouteData.Values["controller"]?.ToString();
        var eylem = ViewContext.RouteData.Values["action"]?.ToString();
        string Aktif(string ad) => string.Equals(kontrolcu, ad, StringComparison.OrdinalIgnoreCase) ? "active" : "";
        // Kitaplığım: raf, istatistikler, yıl özeti ve içe aktar aynı bölümün sekmeleri
        var kitaplikEylemleri = new[] { "Kitapligim", "OkumaIstatistiklerim", "YilOzeti" };
        var kitaplikAktif = (string.Equals(kontrolcu, "Kitap", StringComparison.OrdinalIgnoreCase) && kitaplikEylemleri.Contains(eylem, StringComparer.OrdinalIgnoreCase))
            || string.Equals(kontrolcu, "IceAktar", StringComparison.OrdinalIgnoreCase);
        var kitaplarAktif = string.Equals(kontrolcu, "Kitap", StringComparison.OrdinalIgnoreCase) && !kitaplikAktif;
        var toplulukKontrolcular = new[] { "Sezon", "Oda", "Oneri", "Tartisma", "Ikiz" };
        var toplulukAktif = toplulukKontrolcular.Contains(kontrolcu, StringComparer.OrdinalIgnoreCase);
    }
    <header>
        <nav class="navbar navbar-expand-md sa-nav">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Satır Arası
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#anaMenu" aria-label="Menü">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="anaMenu">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link @Aktif("Admin")" asp-controller="Admin" asp-action="Index">Yönetim</a></li>
                        }
                        @if (User.IsInRole("User"))
                        {
                            <li class="nav-item"><a class="nav-link @(kitaplarAktif || Aktif("AiLibrary") != "" ? "active" : "")" asp-controller="Kitap" asp-action="Index">Kitaplar</a></li>
                            <li class="nav-item"><a class="nav-link @(kitaplikAktif ? "active" : "")" asp-controller="Kitap" asp-action="Kitapligim">Kitaplığım</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(toplulukAktif ? "active" : "")" href="#" id="toplulukMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Topluluk</a>
                                <ul class="dropdown-menu" aria-labelledby="toplulukMenu">
                                    <li><a class="dropdown-item @Aktif("Sezon")" asp-controller="Sezon" asp-action="Index">Sezonlar<small>Dizi gibi birlikte okuma</small></a></li>
                                    <li><a class="dropdown-item @Aktif("Oda")" asp-controller="Oda" asp-action="Index">Okuma odaları<small>Arkadaşlarınla aynı kitap</small></a></li>
                                    <li><a class="dropdown-item @Aktif("Oneri")" asp-controller="Oneri" asp-action="Index">Öneri zincirleri<small>Kitabın kimden kime gittiği</small></a></li>
                                    <li><a class="dropdown-item @Aktif("Ikiz")" asp-controller="Ikiz" asp-action="Index">Okuma ikizi<small>Aynı sayfalarda hisseden okurlar</small></a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item @Aktif("Tartisma")" asp-controller="Tartisma" asp-action="Index">Tartışmalar<small>Genel sohbet</small></a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    @await Component.InvokeAsync("AktifOturum")
                    <button type="button" class="tema-btn" id="temaBtn" aria-label="Koyu / açık tema" title="Koyu / açık tema"><i class="bi bi-moon"></i><i class="bi bi-sun"></i></button>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-5">
        <div class="container d-flex flex-wrap justify-content-between align-items-baseline gap-2 py-4">
            <span class="marka">Satır Arası</span>
            <span>Okuduklarını kaydet, düşüncelerini sakla. &copy; @DateTime.Now.Year</span>
        </div>
    </footer>

    <button class="chat-toggle-btn" onclick="toggleChat()" title="Asistanla Konuş"><i class="bi bi-chat-text"></i></button>

    <div class="chat-widget" id="chatWidget">
        <div class="chat-header">
            <span>Kütüphane Asistanı</span>
            <span class="close-chat" onclick="toggleChat()" aria-label="Kapat">✕</span>
        </div>

        <div class="chat-body" id="chatBody">
            <div class="message bot-message">
                Merhaba! Ben Kütüphane Asistanı. <br>
                Bana "Suç ve Ceza var mı?" veya "Kitaplığımda neler var?" gibi sorular sorabilirsin.
            </div>
        </div>

        <div class="typing-indicator" id="typingIndicator">Asistan yazıyor...</div>

        <div class="chat-footer">
            <input type="text" class="chat-input" id="userMessage" placeholder="Bir şeyler sor..." onkeypress="handleEnter(event)">
            <button type="button" class="send-btn" onclick="sendMessage()">➤</button>
        </div>
    </div>

    <script>
        function toggleChat() {
            var widget = document.getElementById("chatWidget");
            if (widget.style.display === "none" || widget.style.display === "") {
                widget.style.display = "flex";
                setTimeout(() => document.getElementById("userMessage").focus(), 100);
            } else {
                widget.style.display = "none";
            }
        }

        function handleEnter(e) {
            if (e.key === 'Enter') sendMessage();
        }

        async function sendMessage() {
            var input = document.getElementById("userMessage");
            var message = input.value.trim();
            var chatBody = document.getElementById("chatBody");
            var typingIndicator = document.getElementById("typingIndicator");

            // GÜVENLİK İÇİN BUTONU SEÇELİM
            var sendBtn = document.querySelector(".send-btn");

            if (message === "") return;

            // 1. BUTONU KİLİTLE 
            // Kullanıcı cevap gelene kadar tekrar basamaz
            sendBtn.disabled = true;
            sendBtn.style.opacity = "0.5";

            // Kullanıcı mesajını ekle
            chatBody.innerHTML += `<div class="message user-message">${message}</div>`;
            input.value = "";
            scrollToBottom();

            // Backend'e istek at
            typingIndicator.style.display = "block";

            try {
                // AiLibraryController / AskAgent metoduna gidiyoruz
                let response = await fetch('/AiLibrary/AskAgent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': '@(Context.RequestServices.GetRequiredService<Microsoft.AspNetCore.Antiforgery.IAntiforgery>().GetAndStoreTokens(Context).RequestToken)' },
                    body: new URLSearchParams({ 'userMessage': message })
                });

                let data = await response.json();

                typingIndicator.style.display = "none";

                if (data.success) {
                    // Satır sonlarını HTML <br> etiketiyle değiştir
                    let formattedAnswer = data.answer.replace(/\n/g, '<br>');
                    chatBody.innerHTML += `<div class="message bot-message">${formattedAnswer}</div>`;
                } else {
                    chatBody.innerHTML += `<div class="message bot-message text-danger">${data.answer}</div>`;
                }

            } catch (error) {
                typingIndicator.style.display = "none";
                chatBody.innerHTML += `<div class="message bot-message text-danger">Bağlantı hatası oluştu.</div>`;
                console.error(error);
            } finally {
                // 2. İŞLEM BİTİNCE BUTONU TEKRAR AÇ
                sendBtn.disabled = false;
                sendBtn.style.opacity = "1";
                // Kullanıcı tekrar yazabilsin diye inputa odaklan
                input.focus();
            }

            scrollToBottom();
        }

        function scrollToBottom() {
            var chatBody = document.getElementById("chatBody");
            chatBody.scrollTop = chatBody.scrollHeight;
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Açık okuma oturumu sayaçları (sunucudan gelen başlangıç zamanına göre saniyede bir güncellenir)
        (function () {
            var sayaclar = document.querySelectorAll('[data-oturum-baslangic]');
            if (!sayaclar.length) return;
            function iki(n) { return (n < 10 ? '0' : '') + n; }
            function guncelle() {
                sayaclar.forEach(function (el) {
                    var sn = Math.max(0, Math.floor((Date.now() - Number(el.dataset.oturumBaslangic)) / 1000));
                    var s = Math.floor(sn / 3600), d = Math.floor((sn % 3600) / 60);
                    el.textContent = (s > 0 ? iki(s) + ':' : '') + iki(d) + ':' + iki(sn % 60);
                });
            }
            guncelle(); setInterval(guncelle, 1000);
        })();
        document.getElementById('temaBtn')?.addEventListener('click', function () {
            var h = document.documentElement, koyu = h.getAttribute('data-theme') !== 'dark';
            h.setAttribute('data-theme', koyu ? 'dark' : 'light');
            h.setAttribute('data-bs-theme', koyu ? 'dark' : 'light');
            try { localStorage.setItem('sa-tema', koyu ? 'dark' : 'light'); } catch (e) { }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>