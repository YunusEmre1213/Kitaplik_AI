@model KitapYonetimSistemi.Models.BookAnalysisViewModel

@{
    ViewData["Title"] = "Kitap Analizi";
}

<div class="container py-5">
    <a href="javascript:history.back()" class="btn btn-outline-secondary mb-4 rounded-pill px-4">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>

    <div class="row g-5 align-items-start">
        <div class="col-md-4 text-center">
            <div class="card border-0 shadow-lg overflow-hidden position-relative">
                @if (!string.IsNullOrEmpty(Model.CoverUrl))
                {
                    <img src="@Model.CoverUrl" class="img-fluid w-100" style="object-fit:cover; height:450px;" alt="@Model.Title">
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height:450px;">
                        <i class="bi bi-book display-1 text-muted"></i>
                    </div>
                }

                <div class="card-body bg-dark text-white p-4">
                    <h3 class="fw-bold mb-1">@Model.Title</h3>
                    <p class="text-white-50 mb-0">@Model.Author</p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <h5 class="text-uppercase text-primary fw-bold mb-3">
                <i class="bi bi-stars"></i> Yapay Zeka Analizi
            </h5>

            <h1 class="display-6 fw-bold mb-4">Bu Kitap Hakkında Neler Bilmelisin?</h1>

            <div class="card border-0 shadow-sm bg-light mb-4">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold text-dark"><i class="bi bi-card-text me-2"></i> Konusu (Spoiler Yok)</h5>
                    <p class="card-text fs-5 text-secondary">@Model.Summary</p>
                </div>
            </div>

            <div class="alert alert-info border-0 d-flex align-items-center mb-4 p-3 shadow-sm" role="alert">
                <i class="bi bi-lightbulb-fill fs-3 me-3"></i>
                <div>
                    <strong class="d-block text-uppercase small">Ana Tema & Duygu</strong>
                    <span class="fs-5">@Model.Theme</span>
                </div>
            </div>

            <h5 class="fw-bold mt-4 mb-3">Neden Okumalısın?</h5>
            <div class="row g-3 mb-4">
                @if (Model.Reasons != null)
                {
                    @foreach (var reason in Model.Reasons)
                    {
                        <div class="col-12">
                            <div class="d-flex align-items-start p-3 border rounded-3 shadow-sm bg-white hover-card">
                                <i class="bi bi-check-circle-fill text-success fs-4 me-3 mt-1"></i>
                                <p class="mb-0 fs-5">@reason</p>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="card bg-dark text-white border-0 rounded-3 p-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-collection-fill fs-2 me-3 text-warning"></i>
                    <div>
                        <h6 class="text-uppercase text-white-50 mb-1">Şunları sevdiysen bunu da seversin:</h6>
                        <p class="mb-0 fs-5 fw-bold">@Model.SimilarBooks</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>