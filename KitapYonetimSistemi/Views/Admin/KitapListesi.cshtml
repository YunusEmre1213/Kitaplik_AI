@model IEnumerable<KitapYonetimSistemi.Models.Kitap>

@{
    ViewData["Title"] = "Kitap Listesi";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Kitap Listesi</li>
    </ol>
</nav>

<div class="sayfa-baslik">
    <div>
        <span class="etiket">Yönetim</span>
        <h1>Kitap yönetimi</h1>
        <span class="not">@((int)ViewBag.Toplam) kitap</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="DisKaynak" class="btn btn-outline-secondary">Dış kaynaktan ekle</a>
        <a asp-action="KitapEkle" class="btn btn-primary">Yeni kitap</a>
    </div>
</div>

<form method="get" asp-action="KitapListesi" class="d-flex gap-2 mb-4" style="max-width: 520px;">
    <input type="text" name="arama" value="@ViewBag.Arama" class="form-control" placeholder="Kitap adı veya yazar ara..." />
    <button type="submit" class="btn btn-primary">Ara</button>
</form>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Mesaj"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Kapak</th>
                            <th>Kitap Adı</th>
                            <th>Yazar</th>
                            <th>Yayın Yılı</th>
                            <th>Eklenme Tarihi</th>
                            <th style="width: 150px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kitap in Model)
                        {
                            <tr>
                                <td>
                                    <div style="width: 46px;"><partial name="_Kapak" model='KapakModel.Of(kitap, "sm")' /></div>
                                </td>
                                <td><strong>@kitap.KitapAdi</strong></td>
                                <td>@kitap.YazarAdi</td>
                                <td>@kitap.YayinYili</td>
                                <td>@kitap.EklenmeTarihi.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <a asp-action="KitapDuzenle" asp-route-id="@kitap.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a asp-action="KitapSil" asp-route-id="@kitap.Id" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if ((int)ViewBag.ToplamSayfa > 1)
            {
                var sayfa = (int)ViewBag.Sayfa; var son = (int)ViewBag.ToplamSayfa;
                <nav class="mt-3"><ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(sayfa == 1 ? "disabled" : "")"><a class="page-link" asp-action="KitapListesi" asp-route-sayfa="@(sayfa - 1)" asp-route-arama="@ViewBag.Arama">Önceki</a></li>
                    <li class="page-item disabled"><span class="page-link">@sayfa / @son</span></li>
                    <li class="page-item @(sayfa == son ? "disabled" : "")"><a class="page-link" asp-action="KitapListesi" asp-route-sayfa="@(sayfa + 1)" asp-route-arama="@ViewBag.Arama">Sonraki</a></li>
                </ul></nav>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center">
        <h4>Henüz Kitap Yok</h4>
        <p>İlk kitabı eklemek için yukarıdaki butona tıklayın</p>
    </div>
}