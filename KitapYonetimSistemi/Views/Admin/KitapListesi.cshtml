@model IEnumerable<KitapYonetimSistemi.Models.Kitap>

@{
    ViewData["Title"] = "Kitap Listesi";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Kitap Listesi</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">📚 Kitap Yönetimi</h1>
    <div>
        <a asp-action="Index" class="btn btn-secondary">⬅️ Dashboard</a>
        <a asp-action="KitapEkle" class="btn btn-primary">➕ Yeni Kitap</a>
    </div>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Mesaj"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Kapak</th>
                            <th>Kitap Adı</th>
                            <th>Yazar</th>
                            <th>Yayın Yılı</th>
                            <th>Eklenme Tarihi</th>
                            <th style="width: 150px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kitap in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(kitap.KapakResmiUrl))
                                    {
                                        <img src="@kitap.KapakResmiUrl" alt="@kitap.KitapAdi" style="width: 50px; height: 70px; object-fit: cover; border-radius: 5px;">
                                    }
                                    else
                                    {
                                        <div style="width: 50px; height: 70px; background: #e9ecef; border-radius: 5px; display: flex; align-items: center; justify-content: center;">
                                            📚
                                        </div>
                                    }
                                </td>
                                <td><strong>@kitap.KitapAdi</strong></td>
                                <td>@kitap.YazarAdi</td>
                                <td>@kitap.YayinYili</td>
                                <td>@kitap.EklenmeTarihi.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <a asp-action="KitapDuzenle" asp-route-id="@kitap.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a asp-action="KitapSil" asp-route-id="@kitap.Id" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted text-center mt-3">Toplam <strong>@Model.Count()</strong> kitap bulunmaktadır.</p>
        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center">
        <h4>📚 Henüz Kitap Yok</h4>
        <p>İlk kitabı eklemek için yukarıdaki butona tıklayın</p>
    </div>
}