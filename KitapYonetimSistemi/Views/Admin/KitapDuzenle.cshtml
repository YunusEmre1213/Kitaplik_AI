@model KitapYonetimSistemi.Models.Kitap

@{
    ViewData["Title"] = "Kitap Düzenle";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="KitapListesi">Kitap Listesi</a></li>
        <li class="breadcrumb-item active">Kitap Düzenle</li>
    </ol>
</nav>

<h1 class="page-title">✏️ Kitap Düzenle</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="KitapDuzenle" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="EklenmeTarihi" />
                    <input type="hidden" asp-for="KapakResmiUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="KitapAdi" class="form-label">Kitap Adı</label>
                        <input asp-for="KitapAdi" class="form-control" />
                        <span asp-validation-for="KitapAdi" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="YazarAdi" class="form-label">Yazar Adı</label>
                        <input asp-for="YazarAdi" class="form-control" />
                        <span asp-validation-for="YazarAdi" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tur" class="form-label">Tür</label>
                        <select asp-for="Tur" class="form-select" asp-items="@(new SelectList(KitapYonetimSistemi.Models.KitapTurleri.Hepsi))">
                            <option value="">Seçiniz</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="YayinYili" class="form-label">Yayın Yılı</label>
                        <input asp-for="YayinYili" type="number" class="form-control" min="1000" max="2100" />
                        <span asp-validation-for="YayinYili" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Aciklama" class="form-label">Açıklama</label>
                        <textarea asp-for="Aciklama" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Aciklama" class="text-danger"></span>
                    </div>

                    <!-- Mevcut Kapak -->
                    @if (!string.IsNullOrEmpty(Model.KapakResmiUrl))
                    {
                        <div class="mb-3">
                            <label class="form-label">Mevcut Kapak Resmi:</label>
                            <br />
                            <img src="@Model.KapakResmiUrl" alt="@Model.KitapAdi" style="max-width: 200px; max-height: 300px; border-radius: 8px; border: 2px solid #ddd;" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Yeni Kapak Resmi (Opsiyonel)</label>
                        <input type="file" name="kapakResmi" class="form-control" accept="image/*" id="kapakInput" />
                        <small class="form-text text-muted">Yeni resim seçmezseniz mevcut resim korunur</small>
                    </div>

                    <!-- Önizleme -->
                    <div class="mb-3" id="preview" style="display: none;">
                        <label class="form-label">Yeni Resim Önizleme:</label>
                        <br />
                        <img id="previewImg" src="" style="max-width: 200px; max-height: 300px; border-radius: 8px; border: 2px solid #ddd;" />
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">💾 Güncelle</button>
                        <a asp-action="KitapListesi" class="btn btn-secondary">❌ İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">📊 Kitap Bilgileri</div>
            <div class="card-body">
                <p><strong>Eklenme Tarihi:</strong><br />@Model.EklenmeTarihi.ToString("dd MMMM yyyy HH:mm")</p>
                <p><strong>ID:</strong> @Model.Id</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('kapakInput').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                if (file.size > 5242880) {
                    alert('Dosya boyutu 5MB\'dan küçük olmalıdır!');
                    this.value = '';
                    return;
                }
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('previewImg').src = e.target.result;
                    document.getElementById('preview').style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}